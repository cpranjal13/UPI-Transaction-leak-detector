# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Optional)
# Leave as auto to use embedded SQLite without needing PostgreSQL installed:
DB_TYPE=auto
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upitracker
DB_USER=postgres
DB_PASS=root
